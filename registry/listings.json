      "owner": "claude",
      "checks": [
        {
          "type": "json",
          "url": "https://registry.smithery.ai/servers/icosaedro/toolsnap-mcp",
          "tools_path": "description",
          "fields": { "listedTools": "tools.length", "deploymentUrl": "deploymentUrl", "security": "security" },
          "warn_if_contains": { "deploymentUrl": "run.tools" },
          "warn_note": "el MCP Proxy de Smithery (run.tools) cierra el 2026-10-31"
